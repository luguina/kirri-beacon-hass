# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — keep it that way.
#
#   cp secrets.yaml.example secrets.yaml

wifi_ssid: "YourNetwork"
wifi_password: "your-wifi-password"

# Password for the fallback hotspot the board raises if it can't join WiFi.
ap_password: "fallback-ap-password"

# 32 random bytes, base64. Generate one:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "REPLACE_ME_BASE64_32_BYTES"

ota_password: "some-long-random-string"

# The diffuser's BLE address, from nRF Connect or the ESPHome log line:
#   [esp32_ble_tracker] Found device XX:XX:XX:XX:XX:XX ... name='AJBLE100'
#
# Kept in secrets rather than the tracked config because no real address is ever
# committed to this tree (docs/privacy.md).
kirri_mac: "XX:XX:XX:XX:XX:XX"
